{
  "name": "wexample/symfony-wex",
  "description": "Symfony integration of the wex CLI PHP port",
  "type": "library",
  "license": "MIT",
  "version": "10.0.9",
  "autoload": {
    "psr-4": {
      "Wexample\\SymfonyWex\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Wexample\\SymfonyWex\\Tests\\": "tests/"
    }
  },
  "authors": [
    {
      "name": "weeger",
      "email": "romain.weeger@wexample.com"
    }
  ],
  "require": {
    "php": ">=8.5",
    "doctrine/orm": "^3.0",
    "symfony/http-client": "^7.0",
    "symfony/process": "^7.0",
    "symfony/uid": "^7.0",
    "symfony/yaml": "^7.0",
    "wexample/symfony-api": ">=24.0.0",
    "wexample/symfony-live": ">=5.8.0",
    "wexample/symfony-pseudocode": ">=4.0.2",
    "wexample/symfony-forms": ">=19.0.0",
    "wexample/symfony-helpers": ">=19.3.0",
    "wexample/symfony-messenger": ">=4.1.0",
    "wexample/symfony-remote": ">=2.4.0",
    "wexample/php-git": ">=2.0.1",
    "wexample/php-pseudocode": ">=3.1.0",
    "wexample/php-wex": ">=1.1.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^13"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../*",
      "options": {
        "symlink": true
      }
    }
  ],
  "extra": {
    "install": {
      "bundle_env": "all"
    }
  }
}